{% extends 'base.njk' %}

{% block title %}404 — {{ i18n['page_not_found'] or 'Page Not Found' }} — Opencaching.de{% endblock %}

{% block i18n %}
<script>window.OCI18n = {{ i18n_json | safe }};</script>
{% endblock %}

{% block page_content %}
<div class="container py-5 text-center">
    <h1 class="display-1">404</h1>
    <p class="lead">{{ i18n['page_not_found'] or 'Page not found.' }}</p>
    <a href="/" class="btn btn-primary">{{ i18n['back_to_home'] or 'Back to Home' }}</a>
</div>
{% endblock %}
