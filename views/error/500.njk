{% extends 'base.njk' %}

{% block title %}500 — {{ i18n['server_error'] or 'Server Error' }} — Opencaching.de{% endblock %}

{% block i18n %}
<script>window.OCI18n = {{ i18n_json | safe }};</script>
{% endblock %}

{% block page_content %}
<div class="container py-5 text-center">
    <h1 class="display-1">500</h1>
    <p class="lead">{{ i18n['server_error'] or 'Something went wrong.' }}</p>
    <a href="/" class="btn btn-primary">{{ i18n['back_to_home'] or 'Back to Home' }}</a>
</div>
{% endblock %}
