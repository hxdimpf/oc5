{% extends 'base.njk' %}
{% block title %}OpenCaching{% endblock %}

{% block page_content %}
<div class="oc-home">

  {# Left column #}
  <div class="oc-home-side">

    {# Short card #}
    <div class="card oc-card mb-3">
      <div class="card-header fw-bold">
        <i class="fa-solid fa-bolt me-1"></i> {{ i18n['Quick access'] or 'Quick access' }}
      </div>
      <div class="card-body d-flex flex-column gap-2">
        <a href="/livemap" class="btn btn-outline-primary w-100 text-start">
          <i class="fa-solid fa-map me-2"></i>{{ i18n['Live Map'] or 'Live Map' }}
        </a>
        <a href="/caches/" class="btn btn-outline-primary w-100 text-start">
          <i class="fa-solid fa-magnifying-glass me-2"></i>{{ i18n['Search caches'] or 'Search caches' }}
        </a>
        <a href="/cache/new" class="btn btn-outline-primary w-100 text-start">
          <i class="fa-solid fa-plus me-2"></i>{{ i18n['Hide a cache'] or 'Hide a cache' }}
        </a>
      </div>
    </div>

    {# Tall card #}
    <div class="card oc-card">
      <div class="card-header fw-bold">
        <i class="fa-solid fa-circle-question me-1"></i> {{ i18n['What is geocaching?'] or 'What is geocaching?' }}
      </div>
      <div class="card-body">
        <ul class="oc-steps list-unstyled mb-0">
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-map-pin"></i></span>
            <div>
              <strong>{{ i18n['Find'] or 'Find' }}</strong>
              <p class="text-secondary mb-0">{{ i18n['Find a cache near you and navigate by GPS to the coordinates.'] or 'Find a cache near you and navigate by GPS to the coordinates.' }}</p>
            </div>
          </li>
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-box-archive"></i></span>
            <div>
              <strong>{{ i18n['Log it'] or 'Log it' }}</strong>
              <p class="text-secondary mb-0">{{ i18n['Sign the physical logbook and record your find online.'] or 'Sign the physical logbook and record your find online.' }}</p>
            </div>
          </li>
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-star"></i></span>
            <div>
              <strong>{{ i18n['Hide it'] or 'Hide it' }}</strong>
              <p class="text-secondary mb-0">{{ i18n['Place your own cache and share your favourite spots with the community.'] or 'Place your own cache and share your favourite spots with the community.' }}</p>
            </div>
          </li>
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-users"></i></span>
            <div>
              <strong>{{ i18n['Get involved'] or 'Get involved' }}</strong>
              <p class="text-secondary mb-0">{{ i18n['OpenCaching is open, free and entirely community-driven.'] or 'OpenCaching is open, free and entirely community-driven.' }}</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

  </div>

  {# Center column #}
  <div class="oc-home-main">
    <div class="card oc-card h-100">
      <div class="card-body d-flex flex-column align-items-center justify-content-center text-center gap-4 py-5">

        <div>
          <div class="text-center"><span class="badge px-3 py-2 mb-2" style="background:#68a063;font-size:0.85em">Node.js / Express backend</span></div>
          <div class="oc-home-title">OpenCaching</div>
          <p class="text-muted" style="max-width:600px;margin:0.5rem auto 0;font-size:0.85rem">
            This page is served by <strong>OC5</strong>, a Node.js/Express rewrite of the
            opencaching.de backend. It shares the same database, same frontend JavaScript,
            and same <code>oc-frontend</code> submodule as OC4, but replaces PHP/Symfony with
            a minimal JavaScript stack — 8 npm dependencies, ~500 lines of SQL, no ORM,
            no build step. Same architecture, half the size.
          </p>
          <div class="oc-home-subtitle text-secondary">
            {{ i18n['The open geocaching network — free, open, community-driven.'] or 'The open geocaching network — free, open, community-driven.' }}
          </div>
        </div>

        <div class="oc-stats-row">
          <div class="oc-stat">
            <span class="oc-stat-number">{{ cacheCount|number_format(0, ',', '.') }}</span>
            <span class="oc-stat-label">{{ i18n['Active caches'] or 'Active caches' }}</span>
          </div>
          <div class="oc-stat-divider"></div>
          <div class="oc-stat">
            <span class="oc-stat-number">{{ logCount|number_format(0, ',', '.') }}</span>
            <span class="oc-stat-label">{{ i18n['Log entries'] or 'Log entries' }}</span>
          </div>
          <div class="oc-stat-divider"></div>
          <div class="oc-stat">
            <span class="oc-stat-number">{{ userCount|number_format(0, ',', '.') }}</span>
            <span class="oc-stat-label">{{ i18n['Members'] or 'Members' }}</span>
          </div>
        </div>

        <div class="d-flex gap-3 flex-wrap justify-content-center">
          <a href="/livemap" class="btn btn-primary btn-lg px-4">
            <i class="fa-solid fa-map me-2"></i>{{ i18n['To the map'] or 'To the map' }}
          </a>
          <a href="/caches/" class="btn btn-outline-primary btn-lg px-4">
            <i class="fa-solid fa-magnifying-glass me-2"></i>{{ i18n['Search caches'] or 'Search caches' }}
          </a>
        </div>

        <p class="text-secondary mb-0 mt-2" style="max-width: 480px; font-size: 0.9rem;">
          {{ i18n['OpenCaching uses no proprietary map APIs. The live map runs on OpenStreetMap — open, free, no API key required.'] or 'OpenCaching uses no proprietary map APIs. The live map runs on OpenStreetMap — open, free, no API key required.' }}
        </p>

      </div>
    </div>
  </div>

  {# Right column #}
  <div class="oc-home-side">

    {# Tall card #}
    <div class="card oc-card mb-3">
      <div class="card-header fw-bold">
        <i class="fa-solid fa-shield-halved me-1"></i> {{ i18n['Why OpenCaching?'] or 'Why OpenCaching?' }}
      </div>
      <div class="card-body">
        <ul class="list-unstyled oc-why-list mb-0">
          <li><i class="fa-solid fa-check text-success me-2"></i>{{ i18n['No Google dependency'] or 'No Google dependency' }}</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>{{ i18n['Completely free — no premium plans'] or 'Completely free — no premium plans' }}</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>{{ i18n['Open data, open code'] or 'Open data, open code' }}</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>{{ i18n['No tracking, no ads'] or 'No tracking, no ads' }}</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>{{ i18n['GDPR-compliant, servers in Germany'] or 'GDPR-compliant, servers in Germany' }}</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>{{ i18n['API for everyone — openly documented'] or 'API for everyone — openly documented' }}</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>{{ i18n['Dark mode & mobile support'] or 'Dark mode & mobile support' }}</li>
        </ul>
      </div>
    </div>

    {# Short card #}
    <div class="card oc-card">
      <div class="card-body text-center py-4">
        <i class="fa-solid fa-earth-europe fa-2x mb-3" style="color: var(--oc-primary);"></i>
        <p class="mb-0 text-secondary" style="font-size: 0.9rem; line-height: 1.5;">
          {{ i18n['OpenCaching is part of a worldwide network of independent geocaching platforms.'] or 'OpenCaching is part of a worldwide network of independent geocaching platforms.' }}
        </p>
      </div>
    </div>

  </div>

</div>
{% endblock page_content %}
