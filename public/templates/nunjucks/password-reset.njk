{% extends 'base.njk' %}

{% block title %}{{ i18n['forgot_password'] or 'Password Reset' }} — Opencaching.de{% endblock %}

{% block i18n %}
<script>window.OCI18n = {{ i18n_json | safe }};</script>
{% endblock %}

{% block page_content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">{{ i18n['forgot_password'] or 'Password Reset' }}</h2>

                    {% if error %}
                    <div class="alert alert-danger">{{ error }}</div>
                    {% endif %}
                    {% if success %}
                    <div class="alert alert-success">{{ success }}</div>
                    {% endif %}

                    {% if not token %}
                    <p>{{ i18n['password_reset_intro'] or 'Enter your email address and we will send you a reset link.' }}</p>
                    <form method="post" action="/password-reset">
                        <div class="mb-3">
                            <label for="email" class="form-label">{{ i18n['email'] or 'Email' }}</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">{{ i18n['send_reset_link'] or 'Send Reset Link' }}</button>
                    </form>
                    {% else %}
                    <p>{{ i18n['password_reset_new'] or 'Enter your new password.' }}</p>
                    <form method="post" action="/password-reset/{{ token }}">
                        <div class="mb-3">
                            <label for="password" class="form-label">{{ i18n['new_password'] or 'New Password' }}</label>
                            <input type="password" class="form-control" id="password" name="password" required minlength="6">
                        </div>
                        <div class="mb-3">
                            <label for="password2" class="form-label">{{ i18n['password_confirm'] or 'Confirm Password' }}</label>
                            <input type="password" class="form-control" id="password2" name="password2" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">{{ i18n['set_password'] or 'Set Password' }}</button>
                    </form>
                    {% endif %}

                    <hr>
                    <div class="text-center">
                        <a href="/login">{{ i18n['back_to_login'] or 'Back to Login' }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
