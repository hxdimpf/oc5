{% extends 'base.njk' %}

{% block title %}{{ i18n['Search users'] or 'Search users' }} — Opencaching.de{% endblock %}

{% block data_page %}searchusers{% endblock %}

{% block i18n %}
<script>Object.assign(window.OCI18n, {{ i18n_json | safe }});</script>
{% endblock %}

{% block stylesheets %}
{{ super() }}
<link rel="stylesheet" href="/vendor/tabulator/tabulator.min.css">
<link rel="stylesheet" href="/css/tabulator_oc.css">
<style>
    .oc-filter-bar { background: var(--oc-bg-surface); padding: 1rem 1.25rem; border-radius: 0.5rem; margin-bottom: 1rem; }
</style>
{% endblock %}

{% block page_content %}
<div class="container-fluid px-0" id="userSearchContainer">

    <h4 class="mb-3">{{ i18n['Search users'] or 'Search users' }}</h4>

    <div class="oc-filter-bar">
        <form id="searchForm">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="form-label mb-1">{{ i18n['Username'] or 'Username' }}</label>
                    <input type="text" id="fq" class="form-control"
                           placeholder="{{ i18n['e.g. username'] or 'e.g. username' }}"
                           autocomplete="off">
                </div>
                <div class="col-auto ms-md-auto">
                    <button type="submit" class="btn btn-primary">{{ i18n['Search'] or 'Search' }}</button>
                </div>
            </div>
        </form>
    </div>

    <div id="statusBar" class="text-secondary small mb-1" style="min-height:1.4em;"></div>
    <div id="searchResults"></div>

</div>
{% endblock %}
