{% extends 'base.njk' %}

{% block data_page %}livemap{% endblock %}
{% block data_map_js %}true{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block stylesheets %}
{{ super() }}
<link rel="stylesheet" href="/css/map.css">
<style>
    body {
        overflow: hidden;
        height: 100vh;
    }
    main.content {
        padding: 0 !important;
        margin: 0 !important;
        overflow: hidden;
        min-height: 0;
    }
    #mapRoot {
        width: 100%;
        height: calc(100vh - var(--oc-navbar-height));
        margin: 0;
        padding: 0;
        border: none;
    }
    footer { display: none !important; }
</style>
{% endblock %}

{% block i18n %}
<script>Object.assign(window.OCI18n, {{ i18n_json | safe }});</script>
{% endblock %}

{% block after_body_start %}
<script>
    window.uniCacheWP = [];
    (function() {
        var p = new URLSearchParams(location.search);
        window.lat         = p.has('lat')  ? parseFloat(p.get('lat'))  : {{ initLat }};
        window.lon         = p.has('lon')  ? parseFloat(p.get('lon'))  : {{ initLon }};
        window.defaultZoom = p.has('zoom') ? parseInt(p.get('zoom'))   : {{ initZoom }};
    })();
</script>
{% endblock %}

{% block page_content %}
<div id="mapRoot"></div>
{% endblock %}
