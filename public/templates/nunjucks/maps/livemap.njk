{% extends 'base.njk' %}

{% block title %}{{ i18n['livemap'] or 'Live Map' }} — Opencaching.de{% endblock %}

{% block data_page %}livemap{% endblock %}
{% block data_map_js %}true{% endblock %}

{% block stylesheets %}
{{ super() }}
<link rel="stylesheet" href="/css/map.css">
<style>
#mapRoot {
    height: calc(100vh - 56px);
    width: 100%;
    position: relative;
}
</style>
{% endblock %}

{% block i18n %}
<script>window.OCI18n = {{ i18n_json | safe }};</script>
{% endblock %}

{% block page_content %}
<script>
    window.uniCacheWP = [];
    window.lat = {{ lat | default(51.1657) }};
    window.lon = {{ lon | default(10.4515) }};
    window.defaultZoom = {{ defaultZoom | default(6) }};
</script>
<div id="mapRoot"></div>
{% endblock %}
