{% extends 'backoffice/base.njk' %}

{% block title %}{{ i18n['reported_caches'] or 'Reported Caches' }} — Opencaching.de{% endblock %}

{% block data_page %}reportedcaches{% endblock %}

{% block stylesheets %}
{{ super() }}
<link rel="stylesheet" href="/vendor/tabulator/tabulator.min.css">
<link rel="stylesheet" href="/css/tabulator_oc.css">
{% endblock %}

{% block i18n %}
<script>window.OCI18n = {{ i18n_json | safe }};</script>
{% endblock %}

{% block page_content %}
<h1 class="mt-3">{{ i18n['reported_caches'] or 'Reported Caches' }}</h1>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <select id="reportStatusFilter" class="form-select">
                    <option value="all">{{ i18n['all'] or 'All' }}</option>
                    <option value="open">{{ i18n['open'] or 'Open' }}</option>
                    <option value="closed">{{ i18n['closed'] or 'Closed' }}</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div id="reported-caches-table" style="min-height: 500px;"></div>
{% endblock %}
